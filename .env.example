# Copy to .env and change the password. Never commit .env.

# --- database (PostgreSQL, used only by HAPI FHIR) ---
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=hapi
POSTGRES_USER=hapi
POSTGRES_PASSWORD=change-me-local-only

# --- hapi-fhir ---
# Image tag is pinned but has not been pull-tested yet (see CHECKPOINTS.md, C0 blockers).
HAPI_IMAGE=hapiproject/hapi:v7.4.0
HAPI_PORT=8090

# --- api ---
API_PORT=8000
FHIR_TIMEOUT_SECONDS=3

# --- web ---
WEB_PORT=8080
