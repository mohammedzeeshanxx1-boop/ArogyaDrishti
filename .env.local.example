# Localhost-first development (no Docker). Copy to .env.local to override.
# Every URL here is read from the environment; nothing in app code hard-codes a host.

# --- web (Vite dev server) ---
WEB_PORT=5173
# Where Vite proxies /api, /health and /ws during development
VITE_DEV_API_TARGET=http://localhost:8000

# --- api (FastAPI) ---
API_HOST=127.0.0.1
API_PORT=8000
FHIR_BASE_URL=http://localhost:8090/baseR4
FHIR_TIMEOUT_SECONDS=3
FHIR_REQUEST_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths are resolved from the repository root
APP_SQLITE_PATH=.local/api/app.db

# --- HAPI FHIR (native Java, infra/hapi-local) ---
HAPI_PORT=8090
HAPI_DATA_DIR=.local/hapi/data
HAPI_LOCAL_WORK=.local/hapi/work
# Java 11, 17 or 21 for HAPI 5.7. Leave empty to auto-detect (Homebrew openjdk@17/21/11, java_home,
# PATH) or use the private Java 17 that scripts/dev/setup.sh installs into .local/tools/jdk.
HAPI_JAVA=

# --- tests ---
HAPI_TEST_FHIR_BASE=http://localhost:8090/baseR4
